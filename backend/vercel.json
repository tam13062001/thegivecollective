{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/daily-job",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/top-posts/refresh",
      "schedule": "0 0 * * *" 
    },
    {
      "path": "/api/v1/insights/all-posts/refresh",
      "schedule": "0 0 * * *" 
    }
  ]
}