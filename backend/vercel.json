{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/daily-job",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/time-engagement",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/time-engagement-weekly",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/top-posts/refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/all-posts/refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/instagram/profile-clicks",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/insights/instagram/profile-clicks/history",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/ga4-secondary/save-history",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/ga4-secondary/refresh",
      "schedule": "0 0 * * *"
    }
  ]
}