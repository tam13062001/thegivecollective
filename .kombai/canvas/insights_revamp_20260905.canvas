      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap');\n  .briefing-page { font-family: 'Red Hat Text', sans-serif; }\n  .briefing-page .mono { font-family: 'JetBrains Mono', monospace; }\n  .briefing-page .hairline { border-color: #d5dee7; }\n  .briefing-page .soft-rule { background: #d5dee7; }\n  .briefing-page .data-link:hover .data-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }\n  .briefing-page .anchor-link[aria-current='true'] .anchor-rule { opacity: 1; transform: scaleX(1); }\n  .briefing-page .anchor-link[aria-current='true'] { color: #182638; }\n  .briefing-page .filter-button[aria-pressed='true'] { background: #182638; color: #ffffff; border-color: #182638; }\n  .briefing-page .platform-tab[aria-selected='true'] { color: #182638; border-bottom-color: #ed6e83; }\n  .briefing-page .platform-tab[aria-selected='true'] .platform-mark { transform: translateY(-1px); }\n  .briefing-page .platform-mark { transition: transform 160ms ease; }\n  .briefing-page .heat-cell:focus-visible { outline: 2px solid #ed6e83; outline-offset: 2px; }\n  .briefing-page .row-hover:hover { background: #f8fafc; }\n  .briefing-page .loading-rule { animation: loadingRule 1.4s ease-in-out infinite; transform-origin: left; }\n  @keyframes loadingRule { 0%, 100% { transform: scaleX(.25); opacity: .35; } 50% { transform: scaleX(1); opacity: 1; } }\n  @media (prefers-reduced-motion: reduce) { .briefing-page .loading-rule, .briefing-page .platform-mark { animation: none; transition: none; } }\n</style>\n<div class=\"briefing-page min-h-screen bg-[#f3f6f9] text-[#182638]\" data-kid=\"1\" style=\"font-family:'Red Hat Text', sans-serif;\">\n    <nav aria-label=\"Primary navigation\" class=\"fixed inset-x-0 top-0 z-40 h-16 border-b border-[#d5dee7] bg-white/95\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-full max-w-[1440px] items-center justify-between px-8 lg:px-10\" data-kid=\"1-1-1\">\n            <div class=\"flex min-w-0 items-center gap-9\" data-kid=\"1-1-1-1\">\n                <img alt=\"The Give Collective\" class=\"h-10 w-auto shrink-0 object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/src/assets/The%20Give%20Collective.png\"/>\n                <div class=\"flex h-full items-center gap-1\" data-kid=\"1-1-1-1-2\">\n                    <a class=\"flex h-full items-center border-b-2 border-transparent px-3 text-[13px] font-medium text-[#627083] hover:border-[#d5dee7] hover:text-[#182638]\" data-kid=\"1-1-1-1-2-1\" href=\"#briefing\">\n                        Overview\n                    </a>\n                    <a class=\"flex h-full items-center border-b-2 border-[#ed6e83] px-3 text-[13px] font-semibold text-[#182638]\" data-kid=\"1-1-1-1-2-2\" href=\"#briefing\">\n                        Insights & Top Posts\n                    </a>\n                </div>\n            </div>\n            <div class=\"hidden items-center gap-5 md:flex\" data-kid=\"1-1-1-2\">\n                <span class=\"mono text-[10px] uppercase tracking-[0.16em] text-[#627083]\" data-kid=\"1-1-1-2-1\">\n                    Internal briefing\n                </span>\n                <span aria-label=\"Data connection active\" class=\"h-1.5 w-1.5 rounded-full bg-[#17805e]\" data-kid=\"1-1-1-2-2\">\n                </span>\n            </div>\n        </div>\n    </nav>\n    <main class=\"mx-auto max-w-[1440px] px-8 pb-24 pt-24 lg:px-10\" data-kid=\"1-2\">\n        <div class=\"grid grid-cols-[190px_minmax(0,1fr)] gap-0\" data-kid=\"1-2-1\">\n            <aside aria-label=\"Page sections\" class=\"sticky top-24 hidden h-[calc(100vh-8rem)] border-r border-[#d5dee7] pr-8 lg:block\" data-kid=\"1-2-1-1\">\n                <p class=\"mono mb-7 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#627083]\" data-kid=\"1-2-1-1-1\">\n                    Reading desk\n                </p>\n                <nav class=\"space-y-5\" data-kid=\"1-2-1-1-2\">\n                    <a aria-current=\"true\" class=\"anchor-link group relative block pl-4 text-[12px] font-medium text-[#627083]\" data-kid=\"1-2-1-1-2-1\" href=\"#briefing\">\n                        <span class=\"anchor-rule absolute left-0 top-1/2 h-4 w-[3px] -translate-y-1/2 origin-left scale-x-100 bg-[#ed6e83] opacity-100\" data-kid=\"1-2-1-1-2-1-1\">\n                        </span>\n                        <span class=\"mono mr-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-1-2-1-2\">\n                            01\n                        </span>\n                        Briefing\n                    </a>\n                    <a aria-current=\"false\" class=\"anchor-link group relative block pl-4 text-[12px] font-medium text-[#627083]\" data-kid=\"1-2-1-1-2-2\" href=\"#audience\">\n                        <span class=\"anchor-rule absolute left-0 top-1/2 h-4 w-[3px] -translate-y-1/2 origin-left scale-x-0 bg-[#ed6e83] opacity-0 transition-transform\" data-kid=\"1-2-1-1-2-2-1\">\n                        </span>\n                        <span class=\"mono mr-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-1-2-2-2\">\n                            02\n                        </span>\n                        Who we reach\n                    </a>\n                    <a aria-current=\"false\" class=\"anchor-link group relative block pl-4 text-[12px] font-medium text-[#627083]\" data-kid=\"1-2-1-1-2-3\" href=\"#posts\">\n                        <span class=\"anchor-rule absolute left-0 top-1/2 h-4 w-[3px] -translate-y-1/2 origin-left scale-x-0 bg-[#ed6e83] opacity-0 transition-transform\" data-kid=\"1-2-1-1-2-3-1\">\n                        </span>\n                        <span class=\"mono mr-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-1-2-3-2\">\n                            03\n                        </span>\n                        What carried\n                    </a>\n                    <a aria-current=\"false\" class=\"anchor-link group relative block pl-4 text-[12px] font-medium text-[#627083]\" data-kid=\"1-2-1-1-2-4\" href=\"#formats\">\n                        <span class=\"anchor-rule absolute left-0 top-1/2 h-4 w-[3px] -translate-y-1/2 origin-left scale-x-0 bg-[#ed6e83] opacity-0 transition-transform\" data-kid=\"1-2-1-1-2-4-1\">\n                        </span>\n                        <span class=\"mono mr-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-1-2-4-2\">\n                            04\n                        </span>\n                        Compare formats\n                    </a>\n                    <a aria-current=\"false\" class=\"anchor-link group relative block pl-4 text-[12px] font-medium text-[#627083]\" data-kid=\"1-2-1-1-2-5\" href=\"#timing\">\n                        <span class=\"anchor-rule absolute left-0 top-1/2 h-4 w-[3px] -translate-y-1/2 origin-left scale-x-0 bg-[#ed6e83] opacity-0 transition-transform\" data-kid=\"1-2-1-1-2-5-1\">\n                        </span>\n                        <span class=\"mono mr-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-1-2-5-2\">\n                            05\n                        </span>\n                        Publishing windows\n                    </a>\n                </nav>\n                <div class=\"mt-16 border-t border-[#d5dee7] pt-4\" data-kid=\"1-2-1-1-3\">\n                    <p class=\"mono text-[10px] leading-relaxed text-[#627083]\" data-kid=\"1-2-1-1-3-1\">\n                        All times shown in SGT.\n                        <br data-kid=\"1-2-1-1-3-1-1\"/>\n                        Values reflect loaded source data.\n                    </p>\n                </div>\n            </aside>\n            <div class=\"min-w-0 pl-0 lg:pl-12\" data-kid=\"1-2-1-2\">\n                <div class=\"mb-8 flex items-center gap-2 lg:hidden\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"mono text-[10px] font-semibold uppercase tracking-[0.16em] text-[#627083]\" data-kid=\"1-2-1-2-1-1\">\n                        01 / Briefing\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#d5dee7]\" data-kid=\"1-2-1-2-1-2\">\n                    </span>\n                </div>\n                <section class=\"scroll-mt-24 border-b border-[#d5dee7] pb-14\" data-kid=\"1-2-1-2-2\" id=\"briefing\">\n                    <div class=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\" data-kid=\"1-2-1-2-2-1\">\n                        <div data-kid=\"1-2-1-2-2-1-1\">\n                            <p class=\"mono mb-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#2e6c90]\" data-kid=\"1-2-1-2-2-1-1-1\">\n                                Morning readout\n                            </p>\n                            <h1 class=\"max-w-[700px] text-[34px] font-semibold leading-[1.08] tracking-[-0.03em] text-[#182638]\" data-kid=\"1-2-1-2-2-1-1-2\">\n                                Insights & performance\n                            </h1>\n                            <p class=\"mt-3 max-w-[620px] text-[16px] leading-relaxed text-[#627083]\" data-kid=\"1-2-1-2-2-1-1-3\">\n                                A working read of audience, content, and posting patterns.\n                            </p>\n                        </div>\n                        <div class=\"max-w-[330px] md:text-right\" data-kid=\"1-2-1-2-2-1-2\">\n                            <p class=\"mono text-[10px] uppercase tracking-[0.13em] text-[#627083]\" data-kid=\"1-2-1-2-2-1-2-1\">\n                                Source\n                            </p>\n                            <p class=\"mono mt-1 text-[11px] leading-relaxed text-[#182638]\" data-kid=\"1-2-1-2-2-1-2-2\">\n                                Top-post cohort · all available loaded posts · 4 platforms\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-10 grid border-y border-[#d5dee7] bg-white md:grid-cols-3\" data-kid=\"1-2-1-2-2-2\">\n                        <div class=\"border-b border-[#d5dee7] px-5 py-5 md:border-b-0 md:border-r\" data-kid=\"1-2-1-2-2-2-1\">\n                            <div class=\"mb-4 h-1 w-10 bg-[#17805e]\" data-kid=\"1-2-1-2-2-2-1-1\">\n                            </div>\n                            <p class=\"mono text-[10px] uppercase tracking-[0.13em] text-[#627083]\" data-kid=\"1-2-1-2-2-2-1-2\">\n                                Total views\n                            </p>\n                            <p class=\"mt-2 text-[34px] font-semibold tracking-[-0.04em] text-[#182638]\" data-kid=\"1-2-1-2-2-2-1-3\">\n                                883.7K\n                            </p>\n                            <div class=\"mt-3 flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-2-2-1-4\">\n                                <span class=\"text-[12px] text-[#627083]\" data-kid=\"1-2-1-2-2-2-1-4-1\">\n                                    Views across top posts\n                                </span>\n                                <span class=\"mono shrink-0 text-[9px] font-semibold text-[#17805e]\" data-kid=\"1-2-1-2-2-2-1-4-2\">\n                                    TOP POSTS\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"border-b border-[#d5dee7] px-5 py-5 md:border-b-0 md:border-r\" data-kid=\"1-2-1-2-2-2-2\">\n                            <div class=\"mb-4 h-1 w-10 bg-[#2e6c90]\" data-kid=\"1-2-1-2-2-2-2-1\">\n                            </div>\n                            <p class=\"mono text-[10px] uppercase tracking-[0.13em] text-[#627083]\" data-kid=\"1-2-1-2-2-2-2-2\">\n                                Total likes\n                            </p>\n                            <p class=\"mt-2 text-[34px] font-semibold tracking-[-0.04em] text-[#182638]\" data-kid=\"1-2-1-2-2-2-2-3\">\n                                30.2K\n                            </p>\n                            <div class=\"mt-3 flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-2-2-2-4\">\n                                <span class=\"text-[12px] text-[#627083]\" data-kid=\"1-2-1-2-2-2-2-4-1\">\n                                    Likes across top posts\n                                </span>\n                                <span class=\"mono shrink-0 text-[9px] font-semibold text-[#2e6c90]\" data-kid=\"1-2-1-2-2-2-2-4-2\">\n                                    TOP POSTS\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"px-5 py-5\" data-kid=\"1-2-1-2-2-2-3\">\n                            <div class=\"mb-4 h-1 w-10 bg-[#ed6e83]\" data-kid=\"1-2-1-2-2-2-3-1\">\n                            </div>\n                            <p class=\"mono text-[10px] uppercase tracking-[0.13em] text-[#627083]\" data-kid=\"1-2-1-2-2-2-3-2\">\n                                Engagement rate\n                            </p>\n                            <p class=\"mt-2 text-[34px] font-semibold tracking-[-0.04em] text-[#182638]\" data-kid=\"1-2-1-2-2-2-3-3\">\n                                3.4%\n                            </p>\n                            <div class=\"mt-3 flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-2-2-3-4\">\n                                <span class=\"text-[12px] text-[#627083]\" data-kid=\"1-2-1-2-2-2-3-4-1\">\n                                    Likes + shares ÷ views\n                                </span>\n                                <span class=\"mono shrink-0 text-[9px] font-semibold text-[#ed6e83]\" data-kid=\"1-2-1-2-2-2-3-4-2\">\n                                    TOP POSTS\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mono mt-4 text-[10px] text-[#627083]\" data-kid=\"1-2-1-2-2-3\">\n                        Scope note: these headline values describe the top-post cohort, not account-wide performance.\n                    </p>\n                </section>\n                <section class=\"scroll-mt-24 border-b border-[#d5dee7] py-16\" data-kid=\"1-2-1-2-3\" id=\"audience\">\n                    <div class=\"mb-8 flex items-end justify-between gap-6\" data-kid=\"1-2-1-2-3-1\">\n                        <div data-kid=\"1-2-1-2-3-1-1\">\n                            <p class=\"mono mb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#627083]\" data-kid=\"1-2-1-2-3-1-1-1\">\n                                02 / Who we reach\n                            </p>\n                            <h2 class=\"text-[22px] font-semibold tracking-[-0.02em] text-[#182638]\" data-kid=\"1-2-1-2-3-1-1-2\">\n                                Audience snapshot\n                            </h2>\n                        </div>\n                        <p class=\"mono text-right text-[11px] text-[#627083]\" data-kid=\"1-2-1-2-3-1-2\">\n                            1.4K known followers\n                        </p>\n                    </div>\n                    <div class=\"grid border-y border-[#d5dee7] bg-white lg:grid-cols-[270px_minmax(0,1fr)]\" data-kid=\"1-2-1-2-3-2\">\n                        <div class=\"border-b border-[#d5dee7] px-6 py-7 lg:border-b-0 lg:border-r\" data-kid=\"1-2-1-2-3-2-1\">\n                            <p class=\"mono text-[10px] uppercase tracking-[0.14em] text-[#627083]\" data-kid=\"1-2-1-2-3-2-1-1\">\n                                Audience snapshot\n                            </p>\n                            <p class=\"mt-6 text-[30px] font-semibold tracking-[-0.04em] text-[#182638]\" data-kid=\"1-2-1-2-3-2-1-2\">\n                                1.4K\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#627083]\" data-kid=\"1-2-1-2-3-2-1-3\">\n                                followers represented\n                            </p>\n                            <div class=\"mt-12 border-l-[3px] border-[#ed6e83] pl-4\" data-kid=\"1-2-1-2-3-2-1-4\">\n                                <p class=\"text-[13px] font-semibold leading-relaxed text-[#182638]\" data-kid=\"1-2-1-2-3-2-1-4-1\">\n                                    The 25–44 age group makes up the majority of followers with available demographic data.\n                                </p>\n                                <p class=\"mono mt-3 text-[10px] leading-relaxed text-[#627083]\" data-kid=\"1-2-1-2-3-2-1-4-2\">\n                                    Observed across the 25–34 and 35–44 rows.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"min-w-0 px-6 py-7 lg:px-8\" data-kid=\"1-2-1-2-3-2-2\">\n                            <div class=\"mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start\" data-kid=\"1-2-1-2-3-2-2-1\">\n                                <div data-kid=\"1-2-1-2-3-2-2-1-1\">\n                                    <p class=\"text-[14px] font-semibold text-[#182638]\" data-kid=\"1-2-1-2-3-2-2-1-1-1\">\n                                        Followers by age band\n                                    </p>\n                                    <p class=\"mono mt-1 text-[10px] text-[#627083]\" data-kid=\"1-2-1-2-3-2-2-1-1-2\">\n                                        Known followers · count of people\n                                    </p>\n                                </div>\n                                <div class=\"flex flex-wrap gap-4 text-[11px] text-[#627083]\" data-kid=\"1-2-1-2-3-2-2-1-2\">\n                                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-3-2-2-1-2-1\">\n                                        <span cla