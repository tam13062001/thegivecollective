 background colors set by script\" tabindex=\"0\" title=\"Sun ${String(i).padStart(2,'0')}:00 SGT — historical views\">\n                                            </span>\n                                            `).join('')}\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"mt-3 grid grid-cols-[46px_minmax(0,1fr)] gap-4\" data-kid=\"1-2-1-2-6-3-2-1-3\">\n                                    <span data-kid=\"1-2-1-2-6-3-2-1-3-1\">\n                                    </span>\n                                    <div class=\"flex justify-between mono text-[9px] text-[#627083]\" data-kid=\"1-2-1-2-6-3-2-1-3-2\">\n                                        <span data-kid=\"1-2-1-2-6-3-2-1-3-2-1\">\n                                            00:00\n                                        </span>\n                                        <span data-kid=\"1-2-1-2-6-3-2-1-3-2-2\">\n                                            06:00\n                                        </span>\n                                        <span data-kid=\"1-2-1-2-6-3-2-1-3-2-3\">\n                                            12:00\n                                        </span>\n                                        <span data-kid=\"1-2-1-2-6-3-2-1-3-2-4\">\n                                            18:00\n                                        </span>\n                                        <span data-kid=\"1-2-1-2-6-3-2-1-3-2-5\">\n                                            24:00\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-7 flex flex-col justify-between gap-3 border-t border-[#d5dee7] pt-5 sm:flex-row sm:items-center\" data-kid=\"1-2-1-2-6-3-3\">\n                            <p class=\"text-[12px] text-[#627083]\" data-kid=\"1-2-1-2-6-3-3-1\">\n                                Recommended from the selected platform’s historical signal:\n                                <span class=\"mono font-semibold text-[#182638]\" data-kid=\"1-2-1-2-6-3-3-1-1\">\n                                    09:00 · 10:00 · 19:00\n                                </span>\n                            </p>\n                            <button class=\"inline-flex items-center gap-2 text-[11px] font-semibold text-[#2e6c90] hover:text-[#182638]\" data-kid=\"1-2-1-2-6-3-3-2\" data-name=\"refresh timing data button\" type=\"button\">\n                                Refresh timing data\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-6-3-3-2-1\" data-lucide=\"refresh-cw\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 border-y border-[#d5dee7] bg-white\" data-kid=\"1-2-1-2-6-4\">\n                        <div class=\"grid divide-y divide-[#d5dee7] md:grid-cols-3 md:divide-x md:divide-y-0\" data-kid=\"1-2-1-2-6-4-1\">\n                            <div class=\"p-5\" data-kid=\"1-2-1-2-6-4-1-1\">\n                                <p class=\"mono text-[10px] uppercase tracking-[0.12em] text-[#627083]\" data-kid=\"1-2-1-2-6-4-1-1-1\">\n                                    Loading example\n                                </p>\n                                <p class=\"mt-3 text-[12px] font-semibold text-[#182638]\" data-kid=\"1-2-1-2-6-4-1-1-2\" data-name=\"loading status text\">\n                                    Loading audience data…\n                                </p>\n                                <div class=\"mt-3 h-[2px] w-24 origin-left bg-[#2e6c90] loading-rule\" data-kid=\"1-2-1-2-6-4-1-1-3\">\n                                </div>\n                            </div>\n                            <div class=\"p-5\" data-kid=\"1-2-1-2-6-4-1-2\">\n                                <p class=\"mono text-[10px] uppercase tracking-[0.12em] text-[#627083]\" data-kid=\"1-2-1-2-6-4-1-2-1\">\n                                    Empty example\n                                </p>\n                                <p class=\"mt-3 text-[12px] font-semibold text-[#182638]\" data-kid=\"1-2-1-2-6-4-1-2-2\">\n                                    No posts match this filter.\n                                </p>\n                                <p class=\"mono mt-2 text-[10px] text-[#627083]\" data-kid=\"1-2-1-2-6-4-1-2-3\">\n                                    Try another content type.\n                                </p>\n                            </div>\n                            <div class=\"p-5\" data-kid=\"1-2-1-2-6-4-1-3\">\n                                <p class=\"mono text-[10px] uppercase tracking-[0.12em] text-[#627083]\" data-kid=\"1-2-1-2-6-4-1-3-1\">\n                                    Error example\n                                </p>\n                                <div class=\"mt-3 flex items-center justify-between gap-3\" data-kid=\"1-2-1-2-6-4-1-3-2\">\n                                    <p class=\"text-[12px] font-semibold text-[#182638]\" data-kid=\"1-2-1-2-6-4-1-3-2-1\" data-name=\"error message text\">\n                                        Couldn’t load top posts.\n                                    </p>\n                                    <button class=\"inline-flex items-center gap-2 rounded-[6px] border border-[#d5dee7] px-2.5 py-1.5 text-[10px] font-semibold text-[#182638]\" data-kid=\"1-2-1-2-6-4-1-3-2-2\" data-name=\"try again button\" type=\"button\">\n                                        Try again\n                                        <i class=\"h-3 w-3\" data-kid=\"1-2-1-2-6-4-1-3-2-2-1\" data-lucide=\"refresh-cw\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <footer class=\"mt-10 flex flex-col justify-between gap-3 border-t border-[#d5dee7] pt-5 text-[11px] text-[#627083] sm:flex-row\" data-kid=\"1-2-1-2-7\">\n                    <span data-kid=\"1-2-1-2-7-1\">\n                        The Give Collective · Insights & performance\n                    </span>\n                    <span class=\"mono\" data-kid=\"1-2-1-2-7-2\">\n                        Data is shown as loaded · all times SGT\n                    </span>\n                </footer>\n            </div>\n        </div>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', function () {\n      if (window.lucide) window.lucide.createIcons();\n      var heatColors = ['#e7f0f4','#dcebf0','#cde2e9','#b7d5df','#9bc4d1','#76aabd','#5d96ad','#4e889f','#3f7d96','#346f88','#2e6c90','#4d879d','#74a6b6','#9cc4ce','#bad8df','#cfe4e9','#e0edf0','#d3e6ea','#b7d5df','#8cb9c5','#6b9eaf','#4e889f','#3d788f','#dcebf0'];\n      document.querySelectorAll('#timing .grid-cols-24').forEach(function (row, rowIndex) {\n        row.innerHTML = '';\n        for (var hour = 0; hour < 24; hour += 1) {\n          var cell = document.createElement('span');\n          cell.className = 'heat-cell relative block h-7 rounded-[4px]';\n          cell.style.backgroundColor = heatColors[(hour + rowIndex * 3) % heatColors.length];\n          cell.tabIndex = 0;\n          cell.title = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][rowIndex] + ' ' + String(hour).padStart(2, '0') + ':00 SGT — historical views';\n          if (rowIndex === 2 && [8, 9, 18].includes(hour)) {\n            var marker = document.createElement('span');\n            marker.className = 'absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#cb8d19] ring-2 ring-white';\n            cell.appendChild(marker);\n          }\n          row.appendChild(cell);\n        }\n      });\n      var filterButtons = document.querySelectorAll('.filter-button[data-filter]');\n      var rows = document.querySelectorAll('[data-type]');\n      var empty = document.getElementById('filter-empty');\n      filterButtons.forEach(function (button) {\n        button.addEventListener('click', function () {\n          var filter = button.getAttribute('data-filter');\n          filterButtons.forEach(function (item) { item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); });\n          var visible = 0;\n          rows.forEach(function (row) {\n            var show = filter === 'all' || row.getAttribute('data-type') === filter;\n            row.classList.toggle('hidden', !show);\n            if (show) visible += 1;\n          });\n          if (empty) empty.classList.toggle('hidden', visible > 0);\n        });\n      });\n      var tabs = document.querySelectorAll('.platform-tab');\n      tabs.forEach(function (tab) {\n        tab.addEventListener('click', function () {\n          tabs.forEach(function (item) { item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });\n          var label = tab.textContent.trim();\n          var source = document.querySelector('#timing .mt-7 p.mono');\n          if (source) source.textContent = label + ' · all available post history · SGT';\n        });\n      });\n      var anchors = document.querySelectorAll('.anchor-link');\n      anchors.forEach(function (anchor) { anchor.addEventListener('click', function () { anchors.forEach(function (item) { item.setAttribute('aria-current', item === anchor ? 'true' : 'false'); }); }); });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-09-05T22:25:51.833317+00:00",
      "modified": "2026-09-05T22:28:06.273731+00:00",
      "id": "var_350c81616a71",
      "viewportScrollY": 822
    },
    "var_7c44edb18e23": {
      "type": "variant",
      "label": "Insights Revamp — Signal Atlas",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo+Semi+Condensed:wght@500;600;700&family=Azeret+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600;700&display=swap');\n  .font-archivo{font-family:'Archivo Semi Condensed',sans-serif}\n  .font-source{font-family:'Source Sans 3',sans-serif}\n  .font-azeret{font-family:'Azeret Mono',monospace}\n  .thread-line{background:linear-gradient(to bottom,#9AAABB 0%,#D6E0E8 88%,transparent 100%)}\n  .signal-line{background:linear-gradient(to bottom,#1C7394,#D6E0E8)}\n  .heat-1{background:#EAF4F7}.heat-2{background:#D8EDF2}.heat-3{background:#B9DEE8}.heat-4{background:#91C9D8}.heat-5{background:#63AEC2}.heat-6{background:#3A91AA}.heat-7{background:#1C7394}.heat-8{background:#15546D}\n  .grid-guide{background:repeating-linear-gradient(to right,transparent 0,transparent calc(25% - 1px),#D6E0E8 calc(25% - 1px),#D6E0E8 25%)}\n  .bar-segment{height:100%;display:block}\n  .tab-focus:focus-visible,.row-link:focus-visible,.control:focus-visible{outline:2px solid #168468;outline-offset:3px}\n  .row-link:hover .row-title{text-decoration:underline;text-underline-offset:3px}\n  .state-line{height:2px;background:#1C7394;transform-origin:left;animation:stateSweep 1.8s ease-in-out infinite}\n  @keyframes stateSweep{0%,100%{transform:scaleX(.15);opacity:.25}50%{transform:scaleX(1);opacity:1}}\n</style>\n<div class=\"min-h-screen bg-[#F4F7FA] text-[#172A3A] font-source\" data-kid=\"1\" data-name=\"page layout container with atlas id\" id=\"signal-atlas\">\n    <nav class=\"fixed inset-x-0 top-0 z-50 h-16 border-b border-[#D6E0E8] bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-full max-w-[1440px] items-center justify-between px-8\" data-kid=\"1-1-1\">\n            <div class=\"flex h-full items-center gap-10\" data-kid=\"1-1-1-1\">\n                <img alt=\"The Give Collective\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/src/assets/The%20Give%20Collective.png\"/>\n                <div class=\"flex h-full items-center gap-2 text-[14px] font-semibold text-[#617487]\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"px-3 py-2\" data-kid=\"1-1-1-1-2-1\">\n                        Overview\n                    </span>\n                    <span class=\"relative px-3 py-2 text-[#172A3A]\" data-kid=\"1-1-1-1-2-2\">\n                        <span class=\"absolute inset-x-3 bottom-0 h-[3px] bg-[#E56A7C]\" data-kid=\"1-1-1-1-2-2-1\">\n                        </span>\n                        Insights & Top Posts\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 text-xs text-[#617487]\" data-kid=\"1-1-1-2\">\n                <span class=\"font-azeret tracking-tight\" data-kid=\"1-1-1-2-1\">\n                    INTERNAL WORKSPACE\n                </span>\n                <span class=\"h-2 w-2 rounded-full bg-[#168468]\" data-kid=\"1-1-1-2-2\">\n                </span>\n            </div>\n        </div>\n    </nav>\n    <main class=\"mx-auto max-w-[1440px] px-8 pb-28 pt-24\" data-kid=\"1-2\">\n        <section class=\"grid grid-cols-[1fr_430px] gap-16 border-b border-[#D6E0E8] pb-14\" data-kid=\"1-2-1\">\n            <div class=\"flex flex-col justify-end\" data-kid=\"1-2-1-1\">\n                <div class=\"mb-7 flex items-center gap-3 text-[11px] font-azeret font-medium uppercase tracking-[.16em] text-[#617487]\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-[2px] w-8 bg-[#E56A7C]\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    Signals at a glance\n                </div>\n                <h1 class=\"max-w-[700px] font-archivo text-[54px] font-semibold leading-[.98] tracking-[-.035em] text-[#172A3A]\" data-kid=\"1-2-1-1-2\">\n                    Insights &\n                    <br data-kid=\"1-2-1-1-2-1\"/>\n                    <span class=\"text-[#1C7394]\" data-kid=\"1-2-1-1-2-2\">\n                        performance\n                    </span>\n                </h1>\n                <p class=\"mt-6 max-w-[600px] text-[19px] leading-7 text-[#617487]\" data-kid=\"1-2-1-1-3\">\n                    Read the audience, compare what landed, then choose when to post.\n                </p>\n                <div class=\"mt-10 flex items-center gap-3 text-[12px] text-[#617487]\" data-kid=\"1-2-1-1-4\">\n                    <span class=\"font-azeret uppercase tracking-[.11em] text-[#172A3A]\" data-kid=\"1-2-1-1-4-1\">\n                        Top-post cohort\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-[#9AAABB]\" data-kid=\"1-2-1-1-4-2\">\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-1-4-3\" data-name=\"content scope description text\" data-reason=\"text content indicates data availability status potentially updated by script\">\n                        all available loaded data\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-[#9AAABB]\" data-kid=\"1-2-1-1-4-4\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-4-5\">\n                        4 platforms\n                    </span>\n                </div>\n            </div>\n            <div class=\"relative pl-10\" data-kid=\"1-2-1-2\">\n                <div class=\"signal-line absolute left-3 top-1 bottom-1 w-[2px]\" data-kid=\"1-2-1-2-1\">\n                </div>\n                <div class=\"space-y-0\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"relative border-b border-[#D6E0E8] py-3 pl-5\" data-kid=\"1-2-1-2-2-1\">\n                        <span class=\"absolute -left-[33px] top-5 h-3 w-3 rounded-full border-2 border-[#F4F7FA] bg-[#1C7394] ring-1 ring-[#1C7394]\" data-kid=\"1-2-1-2-2-1-1\">\n                        </span>\n                        <div class=\"flex items-end justify-between gap-5\" data-kid=\"1-2-1-2-2-1-2\">\n                            <div data-kid=\"1-2-1-2-2-1-2-1\">\n                                <p class=\"font-azeret text-[11px] uppercase tracking-[.12em] text-[#617487]\" data-kid=\"1-2-1-2-2-1-2-1-1\">\n                                    Total views\n                                </p>\n                                <p class=\"mt-2 font-archivo text-[39px] font-semibold leading-none tabular-nums text-[#172A3A]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2-1-2\" data-name=\"total views count\" data-reason=\"number updated by script from backend\">\n                                    883.7K\n                                </p>\n                            </div>\n                            <span class=\"pb-1 font-azeret text-[10px] text-[#617487]\" data-kid=\"1-2-1-2-2-1-2-2\">\n                                TOP POSTS ONLY\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] text-[#617487]\" data-kid=\"1-2-1-2-2-1-3\">\n                            Reach generated by the loaded top-post cohort.\n                        </p>\n                    </div>\n                    <div class=\"relative border-b border-[#D6E0E8] py-3 pl-5\" data-kid=\"1-2-1-2-2-2\">\n                        <span class=\"absolute -left-[33px] top-5 h-3 w-3 rounded-full border-2 border-[#F4F7FA] bg-[#617487] ring-1 ring-[#617487]\" data-kid=\"1-2-1-2-2-2-1\">\n                        </span>\n                        <div class=\"flex items-end justify-between gap-5\" data-kid=\"1-2-1-2-2-2-2\">\n                            <div data-kid=\"1-2-1-2-2-2-2-1\">\n                                <p class=\"font-azeret text-[11px] uppercase tracking-[.12em] text-[#617487]\" data-kid=\"1-2-1-2-2-2-2-1-1\">\n                                    Total likes\n                                </p>\n                                <p class=\"mt-2 font-archivo text-[39px] font-semibold leading-none tabular-nums text-[#172A3A]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"total likes count\" data-reason=\"number updated by script from backend\">\n                                    30.2K\n                                </p>\n                            </div>\n                            <span class=\"pb-1 font-azeret text-[10px] text-[#617487]\" data-kid=\"1-2-1-2-2-2-2-2\">\n                                TOP POSTS ONLY\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] text-[#617487]\" data-kid=\"1-2-1-2-2-2-3\">\n                            Likes across the same selected cohort.\n                        </p>\n                    </div>\n                    <div class=\"relative py-3 pl-5\" data-kid=\"1-2-1-2-2-3\">\n                        <span class=\"absolute -left-[33px] top-5 h-3 w-3 rounded-full border-2 border-[#F4F7FA] bg-[#E56A7C] ring-1 ring-[#E56A7C]\" data-kid=\"1-2-1-2-2-3-1\">\n                        </span>\n                        <div class=\"flex items-end justify-between gap-5\" data-kid=\"1-2-1-2-2-3-2\">\n                            <div data-kid=\"1-2-1-2-2-3-2-1\">\n                                <p class=\"font-azeret text-[11px] uppercase tracking-[.12em] text-[#617487]\" data-kid=\"1-2-1-2-2-3-2-1-1\">\n                                    Engagement rate\n                                </p>\n                                <p class=\"mt-2 font-archivo text-[39px] font-semibold leading-none tabular-nums text-[#172A3A]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-3-2-1-2\" data-name=\"engagement rate percentage\" data-reason=\"percentage updated by script from backend\">\n                                    3.4%\n                                </p>\n                            </div>\n                            <span class=\"pb-1 font-azeret text-[10px] text-[#617487]\" data-kid=\"1-2-1-2-2-3-2-2\">\n                                LIKES + SHARES / VIEWS\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] text-[#617487]\" data-kid=\"1-2-1-2-2-3-3\">\n                            A cohort read, not an account-wide growth rate.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative grid grid-cols-[250px_1fr] gap-12 border-b border-[#D6E0E8] py-20\" data-kid=\"1-2-2\">\n            <div class=\"thread-line absolute left-3 top-0 bottom-0 w-[2px]\" data-kid=\"1-2-2-1\">\n            </div>\n            <div class=\"relative pl-8\" data-kid=\"1-2-2-2\">\n                <p class=\"font-azeret text-[13px] font-medium text-[#E56A7C]\" data-kid=\"1-2-2-2-1\">\n                    01\n                </p>\n                <h2 class=\"mt-3 font-archivo text-[29px] font-semibold tracking-[-.02em]\" data-kid=\"1-2-2-2-2\">\n                    Audience shape\n                </h2>\n                <p class=\"mt-3 font-azeret text-[10px] uppercase tracking-[.14em] text-[#617487]\" data-kid=\"1-2-2-2-3\">\n                    Audience snapshot\n                </p>\n                <p class=\"mt-8 font-archivo text-[32px] font-semibold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-2-2-2-4\" data-name=\"known followers count\" data-reason=\"number updated by script from backend\">\n                    1.4K\n                </p>\n                <p class=\"mt-1 text-sm text-[#617487]\" data-kid=\"1-2-2-2-5\">\n                    known followers\n                </p>\n                <div class=\"mt-10 border-l-[3px] border-[#E56A7C] pl-4 text-[15px] leading-6 text-[#425466]\" data-kid=\"1-2-2-2-6\">\n                    The 25–44 age bands make up the majority of followers with available demographic data.\n                </div>\n            </div>\n            <div class=\"rounded-[16px] bg-[#FCFDFE] p-7 ring-1 ring-[#D6E0E8]\" data-kid=\"1-2-2-3\">\n                <div class=\"flex items-start justify-between border-b border-[#D6E0E8] pb-5\" data-kid=\"1-2-2-3-1\">\n                    <div data-kid=\"1-2-2-3-1-1\">\n                        <h3 class=\"font-archivo text-[21px] font-semibold\" data-kid=\"1-2-2-3-1-1-1\">\n                            Known followers by age band\n                        </h3>\n                        <p class=\"mt-1 text-sm text-[#617487]\" data-kid=\"1-2-2-3-1-1-2\">\n                            Gender disclosure shown as stacked segments.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-5 text-[12px] text-[#617487]\" data-kid=\"1-2-2-3-1-2\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-2-1\">\n                            <i class=\"h-2.5 w-2.5 rounded-full bg-[#E64A8A]\" data-kid=\"1-2-2-3-1-2-1-1\">\n                            </i>\n                            Female\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-2-2\">\n                            <i class=\"h-2.5 w-2.5 rounded-full bg-[#5967D8]\" data-kid=\"1-2-2-3-1-2-2-1\">\n                            </i>\n                            Male\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-2-3\">\n                            <i class=\"h-2.5 w-2.5 rounded-full bg-[#C2CBD7]\" data-kid=\"1-2-2-3-1-2-3-1\">\n                            </i>\n                            Undisclosed\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative mt-6\" data-kid=\"1-2-2-3-2\">\n                    <div class=\"grid-guide pointer-events-none absolute inset-x-[94px] top-0 bottom-9 opacity-80\" data-kid=\"1-2-2-3-2-1\">\n                    </div>\n                    <div class=\