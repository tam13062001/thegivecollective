      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  .font-display { font-family: 'Familjen Grotesk', sans-serif; }\n  .font-mono-ui { font-family: 'IBM Plex Mono', monospace; }\n  .rule-link:hover .rule-title { color: #152238; text-decoration: underline; text-decoration-color: #087A61; text-underline-offset: 3px; }\n  .rule-link:hover .row-arrow { opacity: 1; transform: translateX(2px); }\n  .row-arrow { opacity: 0; transition: opacity 150ms ease, transform 150ms ease; }\n  .filter-button[data-active='true'] { background: #152238; color: white; border-color: #152238; }\n  .filter-button:focus-visible, .platform-tab:focus-visible, .index-link:focus-visible, .state-action:focus-visible { outline: 2px solid #087A61; outline-offset: 3px; }\n  .platform-tab[data-active='true'] { color: #152238; border-bottom-color: #E56A7C; }\n  .timing-view[data-visible='false'] { display: none; }\n  .heat-cell { position: relative; min-width: 16px; aspect-ratio: 1 / 1; border-radius: 4px; }\n  .heat-cell:focus-visible { outline: 2px solid #152238; outline-offset: 2px; z-index: 2; }\n  .heat-marker { width: 7px; height: 7px; border-radius: 999px; background: #CB8D19; box-shadow: 0 0 0 2px rgba(255,255,255,.72); }\n  .metric-rule { height: 4px; width: 44px; }\n  .state-line { height: 10px; border-radius: 2px; background: #E8EEF3; }\n  .chart-guide { border-left: 1px dashed #DCE4EC; }\n  .sticky-col { position: sticky; left: 0; background: #FFFFFF; z-index: 1; }\n  @media (max-width: 1023px) {\n    .desktop-rail { display: none; }\n    .content-layout { display: block; }\n  }\n</style>\n<div class=\"min-h-screen bg-[#F6F8FB] text-[#152238] font-display\" data-kid=\"1\">\n    <header class=\"fixed inset-x-0 top-0 z-50 h-16 border-b border-[#DCE4EC] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-full max-w-[1440px] items-center justify-between px-7 lg:px-10\" data-kid=\"1-1-1\">\n            <div class=\"flex h-full items-center gap-8\" data-kid=\"1-1-1-1\">\n                <img alt=\"The Give Collective\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/src/assets/The%20Give%20Collective.png\"/>\n                <nav aria-label=\"Primary navigation\" class=\"flex h-full items-center gap-1\" data-kid=\"1-1-1-1-2\">\n                    <a class=\"relative inline-flex h-full items-center px-4 text-[13px] font-medium text-[#5C6B7D] hover:text-[#152238]\" data-kid=\"1-1-1-1-2-1\" href=\"#\">\n                        Overview\n                    </a>\n                    <a class=\"relative inline-flex h-full items-center px-4 text-[13px] font-semibold text-[#152238] after:absolute after:inset-x-3 after:bottom-0 after:h-[3px] after:bg-[#E56A7C]\" data-kid=\"1-1-1-1-2-2\" href=\"#scan\">\n                        Insights & Top Posts\n                    </a>\n                </nav>\n            </div>\n            <div class=\"hidden items-center gap-3 text-right lg:flex\" data-kid=\"1-1-1-2\">\n                <span class=\"h-2 w-2 rounded-full bg-[#087A61]\" data-kid=\"1-1-1-2-1\">\n                </span>\n                <span class=\"font-mono-ui text-[10px] font-medium uppercase tracking-[0.16em] text-[#5C6B7D]\" data-kid=\"1-1-1-2-2\">\n                    Internal analytics / SGT\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-7 pb-28 pt-24 lg:px-10\" data-kid=\"1-2\">\n        <div class=\"content-layout grid grid-cols-[132px_minmax(0,1fr)] gap-10\" data-kid=\"1-2-1\">\n            <aside class=\"desktop-rail sticky top-24 h-fit border-r border-[#DCE4EC] pr-7\" data-kid=\"1-2-1-1\">\n                <p class=\"font-mono-ui text-[9px] font-semibold uppercase tracking-[0.18em] text-[#5C6B7D]\" data-kid=\"1-2-1-1-1\">\n                    Reading order\n                </p>\n                <nav aria-label=\"Insights sections\" class=\"mt-7 space-y-6\" data-kid=\"1-2-1-1-2\">\n                    <a class=\"index-link group flex gap-3 text-[#152238]\" data-kid=\"1-2-1-1-2-1\" href=\"#scan\">\n                        <span class=\"font-mono-ui text-[11px] font-semibold text-[#E56A7C]\" data-kid=\"1-2-1-1-2-1-1\">\n                            01\n                        </span>\n                        <span class=\"text-[12px] font-semibold leading-4\" data-kid=\"1-2-1-1-2-1-2\">\n                            Scan\n                            <br data-kid=\"1-2-1-1-2-1-2-1\"/>\n                            the cohort\n                        </span>\n                    </a>\n                    <a class=\"index-link group flex gap-3 text-[#5C6B7D] hover:text-[#152238]\" data-kid=\"1-2-1-1-2-2\" href=\"#audience\">\n                        <span class=\"font-mono-ui text-[11px] font-semibold text-[#5C6B7D] group-hover:text-[#087A61]\" data-kid=\"1-2-1-1-2-2-1\">\n                            02\n                        </span>\n                        <span class=\"text-[12px] font-medium leading-4\" data-kid=\"1-2-1-1-2-2-2\">\n                            Understand\n                            <br data-kid=\"1-2-1-1-2-2-2-1\"/>\n                            the audience\n                        </span>\n                    </a>\n                    <a class=\"index-link group flex gap-3 text-[#5C6B7D] hover:text-[#152238]\" data-kid=\"1-2-1-1-2-3\" href=\"#content\">\n                        <span class=\"font-mono-ui text-[11px] font-semibold text-[#5C6B7D] group-hover:text-[#087A61]\" data-kid=\"1-2-1-1-2-3-1\">\n                            03\n                        </span>\n                        <span class=\"text-[12px] font-medium leading-4\" data-kid=\"1-2-1-1-2-3-2\">\n                            Inspect\n                            <br data-kid=\"1-2-1-1-2-3-2-1\"/>\n                            content\n                        </span>\n                    </a>\n                    <a class=\"index-link group flex gap-3 text-[#5C6B7D] hover:text-[#152238]\" data-kid=\"1-2-1-1-2-4\" href=\"#timing\">\n                        <span class=\"font-mono-ui text-[11px] font-semibold text-[#5C6B7D] group-hover:text-[#087A61]\" data-kid=\"1-2-1-1-2-4-1\">\n                            04\n                        </span>\n                        <span class=\"text-[12px] font-medium leading-4\" data-kid=\"1-2-1-1-2-4-2\">\n                            Choose a\n                            <br data-kid=\"1-2-1-1-2-4-2-1\"/>\n                            posting window\n                        </span>\n                    </a>\n                </nav>\n                <div class=\"mt-16 border-t border-[#DCE4EC] pt-4\" data-kid=\"1-2-1-1-3\">\n                    <p class=\"font-mono-ui text-[9px] uppercase tracking-[0.14em] text-[#5C6B7D]\" data-kid=\"1-2-1-1-3-1\">\n                        Data posture\n                    </p>\n                    <p class=\"mt-2 text-[11px] leading-4 text-[#5C6B7D]\" data-kid=\"1-2-1-1-3-2\">\n                        Real loaded posts, readable scope, no invented reporting period.\n                    </p>\n                </div>\n            </aside>\n            <div class=\"min-w-0\" data-kid=\"1-2-1-2\">\n                <section aria-labelledby=\"page-title\" data-kid=\"1-2-1-2-1\" id=\"scan\">\n                    <div class=\"flex flex-col justify-between gap-8 border-b border-[#DCE4EC] pb-9 lg:flex-row lg:items-end\" data-kid=\"1-2-1-2-1-1\">\n                        <div class=\"max-w-[720px]\" data-kid=\"1-2-1-2-1-1-1\">\n                            <p class=\"font-mono-ui text-[10px] font-semibold uppercase tracking-[0.2em] text-[#087A61]\" data-kid=\"1-2-1-2-1-1-1-1\">\n                                Insights workspace / field note\n                            </p>\n                            <h1 class=\"mt-4 text-[42px] font-semibold leading-[0.98] tracking-[-0.045em] text-[#152238]\" data-kid=\"1-2-1-2-1-1-1-2\" id=\"page-title\">\n                                Insights\n                                <span class=\"text-[#E56A7C]\" data-kid=\"1-2-1-2-1-1-1-2-1\">\n                                    &\n                                </span>\n                                performance\n                            </h1>\n                            <p class=\"mt-5 max-w-[620px] text-[17px] leading-7 text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-1-1-3\">\n                                Read the audience, compare what landed, then choose when to post.\n                            </p>\n                        </div>\n                        <div class=\"max-w-[360px] border-l-2 border-[#087A61] pl-4 lg:mb-1\" data-kid=\"1-2-1-2-1-1-2\">\n                            <p class=\"font-mono-ui text-[9px] font-semibold uppercase tracking-[0.16em] text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-1-2-1\">\n                                Cohort / source\n                            </p>\n                            <p class=\"mt-2 text-[13px] font-medium leading-5 text-[#152238]\" data-kid=\"1-2-1-2-1-1-2-2\">\n                                Top-post cohort\n                                <span class=\"text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-1-2-2-1\">\n                                    ·\n                                </span>\n                                all available loaded posts\n                                <span class=\"text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-1-2-2-2\">\n                                    ·\n                                </span>\n                                4 platforms\n                            </p>\n                        </div>\n                    </div>\n                    <div aria-label=\"Cohort metrics\" class=\"mt-9 border-y border-[#DCE4EC] bg-white\" data-kid=\"1-2-1-2-1-2\">\n                        <dl class=\"grid grid-cols-1 divide-y divide-[#DCE4EC] sm:grid-cols