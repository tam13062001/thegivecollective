                   <span class=\"heat-2 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-1\" data-name=\"hourly heatmap cell\">\n                            </span>\n                            <span class=\"heat-2 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-2\">\n                            </span>\n                            <span class=\"heat-3 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-3\">\n                            </span>\n                            <span class=\"heat-3 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-4\">\n                            </span>\n                            <span class=\"heat-4 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-5\">\n                            </span>\n                            <span class=\"heat-5 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-6\">\n                            </span>\n                            <span class=\"heat-5 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-7\">\n                            </span>\n                            <span class=\"heat-6 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-8\">\n                            </span>\n                            <span class=\"heat-7 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-9\">\n                            </span>\n                            <span class=\"heat-7 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-10\">\n                            </span>\n                            <span class=\"heat-8 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-11\">\n                            </span>\n                            <span class=\"heat-8 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-12\">\n                            </span>\n                            <span class=\"heat-8 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-13\">\n                            </span>\n                            <span class=\"heat-8 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-14\">\n                            </span>\n                            <span class=\"heat-7 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-15\">\n                            </span>\n                            <span class=\"heat-7 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-16\">\n                            </span>\n                            <span class=\"heat-6 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-17\">\n                            </span>\n                            <span class=\"heat-6 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-18\">\n                            </span>\n                            <span class=\"heat-5 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-19\">\n                            </span>\n                            <span class=\"heat-5 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-20\">\n                            </span>\n                            <span class=\"heat-4 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-21\">\n                            </span>\n                            <span class=\"heat-3 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-22\">\n                            </span>\n                            <span class=\"heat-2 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-23\">\n                            </span>\n                            <span class=\"heat-2 h-7 rounded-[4px]\" data-kid=\"1-2-5-2-3-2-3-24\">\n                            </span>\n                        </div>\n                        <p class=\"mt-5 text-[13px] text-[#617487]\" data-kid=\"1-2-5-2-3-2-4\" data-name=\"hourly recommendation text\">\n                            Recommended times:\n                            <span class=\"font-azeret font-semibold text-[#1C7394]\" data-kid=\"1-2-5-2-3-2-4-1\" data-name=\"recommended time interval\">\n                                10:00, 13:00, 19:00\n                            </span>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-[#D6E0E8] pt-10\" data-kid=\"1-2-6\">\n            <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-6-1\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <p class=\"font-azeret text-[11px] uppercase tracking-[.13em] text-[#617487]\" data-kid=\"1-2-6-1-1-1\">\n                        State examples\n                    </p>\n                    <p class=\"mt-1 text-sm text-[#617487]\" data-kid=\"1-2-6-1-1-2\">\n                        The layout stays truthful while each data source resolves independently.\n                    </p>\n                </div>\n                <button class=\"control flex items-center gap-2 rounded-[8px] border border-[#B9C7D2] bg-white px-3 py-2 text-[12px] font-semibold text-[#172A3A]\" data-kid=\"1-2-6-1-2\" data-name=\"refresh button\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-6-1-2-1\" data-lucide=\"refresh-cw\">\n                    </i>\n                    Try again\n                </button>\n            </div>\n            <div class=\"grid grid-cols-3 divide-x divide-[#D6E0E8] border-y border-[#D6E0E8] bg-white\" data-kid=\"1-2-6-2\">\n                <div class=\"px-5 py-4\" data-kid=\"1-2-6-2-1\">\n                    <p class=\"font-azeret text-[10px] uppercase tracking-[.1em] text-[#617487]\" data-kid=\"1-2-6-2-1-1\">\n                        Audience\n                    </p>\n                    <div class=\"mt-3 flex items-center gap-3\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-2\" data-name=\"audience loading container\" data-reason=\"content replaced by data or loading indicator by script\">\n                        <span class=\"font-archivo text-2xl\" data-kid=\"1-2-6-2-1-2-1\">\n                            —\n                        </span>\n                        <span class=\"text-[13px] text-[#617487]\" data-kid=\"1-2-6-2-1-2-2\">\n                            Loading audience data…\n                        </span>\n                    </div>\n                    <div class=\"state-line mt-4 w-full\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-3\" data-name=\"loading bar animation\" data-reason=\"loading progress animation displayed by script\">\n                    </div>\n                </div>\n                <div class=\"px-5 py-4\" data-kid=\"1-2-6-2-2\">\n                    <p class=\"font-azeret text-[10px] uppercase tracking-[.1em] text-[#617487]\" data-kid=\"1-2-6-2-2-1\">\n                        Top posts · Video\n                    </p>\n                    <div class=\"mt-3 text-[13px] text-[#617487]\" data-kid=\"1-2-6-2-2-2\">\n                        No posts match “Video”.\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#1C7394]\" data-kid=\"1-2-6-2-2-3\">\n                        Try another content type.\n                    </p>\n                </div>\n                <div class=\"px-5 py-4\" data-kid=\"1-2-6-2-3\">\n                    <p class=\"font-azeret text-[10px] uppercase tracking-[.1em] text-[#617487]\" data-kid=\"1-2-6-2-3-1\">\n                        Timing · TikTok\n                    </p>\n                    <div class=\"mt-3 text-[13px] text-[#617487]\" data-kid=\"1-2-6-2-3-2\">\n                        No post history is available for this platform.\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();\n    </script>\n    <style id=\"midnight-signal-overrides\">\n        #signal-atlas { background:#010B13 !important; color:#F5F5F5 !important; }\n      #signal-atlas .bg-white, #signal-atlas .bg-white\\/95 { background-color:#0B1624 !important; }\n      #signal-atlas .bg-\\[\\#F4F7FA\\] { background-color:#010B13 !important; }\n      #signal-atlas .bg-\\[\\#FCFDFE\\] { background-color:#1E2952 !important; }\n      #signal-atlas .bg-\\[\\#EAF4F7\\] { background-color:#11162B !important; }\n      #signal-atlas [class*=\"border-\\[\\#D6E0E8\\]\"], #signal-atlas [class*=\"divide-\\[\\#D6E0E8\\]\"] { border-color:#2A3439 !important; }\n      #signal-atlas [class*=\"border-\\[\\#B9C7D2\\]\"] { border-color:#536878 !important; }\n      #signal-atlas [class*=\"border-\\[\\#B9DEE8\\]\"] { border-color:#284B63 !important; }\n      #signal-atlas [class*=\"text-\\[\\#172A3A\\]\"] { color:#F5F5F5 !important; }\n      #signal-atlas [class*=\"text-\\[\\#617487\\]\"], #signal-atlas [class*=\"text-\\[\\#425466\\]\"] { color:#BEBFC5 !important; }\n      #signal-atlas [class*=\"text-\\[\\#1C7394\\]\"] { color:#0FFFFF !important; }\n      #signal-atlas [class*=\"bg-\\[\\#1C7394\\]\"] { background-color:#0FFFFF !important; }\n      #signal-atlas [class*=\"bg-\\[\\#E56A7C\\]\"] { background-color:#EE204E !important; }\n      #signal-atlas [class*=\"text-\\[\\#E56A7C\\]\"] { color:#EE204E !important; }\n      #signal-atlas [class*=\"border-\\[\\#E56A7C\\]\"] { border-color:#EE204E !important; }\n      #signal-atlas [class*=\"bg-\\[\\#168468\\]\"] { background-color:#0FFFFF !important; }\n      #signal-atlas [class*=\"text-\\[\\#168468\\]\"] { color:#0FFFFF !important; }\n      #signal-atlas [class*=\"border-\\[\\#168468\\]\"] { border-color:#0FFFFF !important; }\n      #signal-atlas [class*=\"bg-\\[\\#E64A8A\\]\"] { background-color:#EE204E !important; }\n      #signal-atlas [class*=\"bg-\\[\\#5967D8\\]\"] { background-color:#0FFFFF !important; }\n      #signal-atlas [class*=\"bg-\\[\\#C2CBD7\\]\"] { background-color:#BEBFC5 !important; }\n      #signal-atlas [class*=\"bg-\\[\\#D48B18\\]\"] { background-color:#FFA000 !important; }\n      #signal-atlas .thread-line { background:linear-gradient(to bottom,rgba(238,32,78,.85),rgba(30,41,82,.85) 88%,transparent) !important; }\n      #signal-atlas .signal-line { background:linear-gradient(to bottom,#0FFFFF,rgba(30,41,82,.85)) !important; }\n      #signal-atlas .grid-guide { background:repeating-linear-gradient(to right,transparent 0,transparent calc(25% - 1px),#2A3439 calc(25% - 1px),#2A3439 25%) !important; }\n      #signal-atlas .heat-1 { background:#11162B !important; }\n      #signal-atlas .heat-2 { background:#0D3852 !important; }\n      #signal-atlas .heat-3 { background:#11557A !important; }\n      #signal-atlas .heat-4 { background:#1572A1 !important; }\n      #signal-atlas .heat-5 { background:#1A8FC9 !important; }\n      #signal-atlas .heat-6 { background:#1EACF0 !important; }\n      #signal-atlas .heat-7 { background:#40CCFF !important; }\n      #signal-atlas .heat-8 { background:#0FFFFF !important; }\n      #signal-atlas .state-line { background:#0FFFFF !important; }\n      #signal-atlas .tab-focus:focus-visible,#signal-atlas .row-link:focus-visible,#signal-atlas .control:focus-visible { outline-color:#0FFFFF !important; }\n      #signal-atlas .row-link:hover .row-title { color:#0FFFFF !important; }\n    </style>\n</div>\n",
