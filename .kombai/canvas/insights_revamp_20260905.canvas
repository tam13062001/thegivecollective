             <div class=\"px-6 py-6 lg:px-7\" data-kid=\"1-2-1-2-1-2-1-3\">\n                                <div class=\"metric-rule bg-[#5261D3]\" data-kid=\"1-2-1-2-1-2-1-3-1\">\n                                </div>\n                                <dt class=\"mt-4 text-[12px] font-semibold text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-2-1-3-2\">\n                                    Engagement rate\n                                </dt>\n                                <dd class=\"mt-2 font-mono-ui text-[34px] font-semibold tracking-[-0.06em] text-[#152238]\" data-kid=\"1-2-1-2-1-2-1-3-3\">\n                                    3.4%\n                                </dd>\n                                <p class=\"mt-2 font-mono-ui text-[10px] leading-4 text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-2-1-3-4\">\n                                    Likes + shares ÷ views · top posts\n                                </p>\n                            </div>\n                        </dl>\n                    </div>\n                    <p class=\"mt-4 font-mono-ui text-[10px] leading-5 text-[#5C6B7D]\" data-kid=\"1-2-1-2-1-3\">\n                        Numbers describe the selected top-post cohort; content comparisons below use all available post history.\n                    </p>\n                </section>\n                <section aria-labelledby=\"audience-title\" class=\"mt-20 border-t border-[#DCE4EC] pt-10\" data-kid=\"1-2-1-2-2\" id=\"audience\">\n                    <div class=\"grid gap-9 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-12\" data-kid=\"1-2-1-2-2-1\">\n                        <div data-kid=\"1-2-1-2-2-1-1\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-2-1-1-1\">\n                                <span class=\"font-mono-ui text-[12px] font-semibold text-[#087A61]\" data-kid=\"1-2-1-2-2-1-1-1-1\">\n                                    02\n                                </span>\n                                <span class=\"h